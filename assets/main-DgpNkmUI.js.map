import Component from '@glimmer/component';
import { action } from '@ember/object';
import { on } from '@ember/modifier';
import OdyIcon from './icon.gjs';
import OdyLoadingSpinner from './loading-spinner.gjs';

// Helper local para substituir o helper `or` do pacote externo.
// Retorna o primeiro valor "truthy" ou, se todos forem falsy,
// retorna o último valor da lista (semelhante ao helper Ember `or`).
function or(...values) {
	for (let value of values) {
		if (value) {
			return value;
		}
	}

	return values[values.length - 1];
}

export default class OdyButton extends Component {
  get variantClass() {
    return this.args.variant === 'ghost' ? 'light' : this.args.variant;
  }

  @action
  handleClick(event) {
    this.args.onClick?.(event);

    let target = event.target;
    let parent = target && target.parentNode && target.parentNode.parentNode;

    if (this.args.variant === 'ghost' && parent && typeof parent.blur === 'function') {
      parent.blur();
    }
  }

  <template>
    <button
      type={{or @type "button"}}
      class="
        ody-button
        btn
        btn-{{or this.variantClass "primary"}}
        ody-button--size-{{or @size "base"}}
        {{or @appearance "interaction"}}
        {{if @isLoading "ody-button--loading"}}
        {{if @isIconOnly "ody-button--icon-only"}}
        {{if @isActive "ody-button--active"}}
        {{if @isDisabled "ody-button--disabled"}}
        {{if @iconRotate "ody-button--rotate"}}
      "
      disabled={{@isDisabled}}
      aria-expanded={{if @isActive "true" "false"}}
      {{on "click" this.handleClick}}
      data-test-ody-button
      ...attributes
    >
      {{#if @leftIcon}}
        <OdyIcon
          class="ody-button__left-icon"
          @size={{@iconSize}}
          @source={{@leftIcon}}
          data-test-ody-button-left-icon
        />
      {{/if}}

      {{yield}}
      {{@label}}

      {{#if @rightIcon}}
        <OdyIcon
          class="ody-button__right-icon"
          @size={{@iconSize}}
          @source={{@rightIcon}}
          data-test-ody-button-right-icon
        />
      {{/if}}

      {{#if @isLoading}}
        <div class="ody-button__loading-wrapper">
          <OdyLoadingSpinner
            @source="spinner"
            data-test-ody-button-loading
          />
        </div>
      {{/if}}
    </button>
  </template>
}

