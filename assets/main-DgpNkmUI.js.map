import Component from '@glimmer/component';
import OdyIcon from './icon';

export default class MessageComponent extends Component {
  get getIcon() {
    return this.args.message ? `icon-${this.args.message}` : 'info';
  }

  <template>
    <div class="ody-message-container" aria-label={{@accessibilityLabel}} data-test-ody-message-container ...attributes>
      <OdyIcon class="ody-message__icon" @source={{this.getIcon}} @size="small" />
      <span class="ody-message" data-test-ody-message>{{yield}}</span>
    </div>
  </template>
}

