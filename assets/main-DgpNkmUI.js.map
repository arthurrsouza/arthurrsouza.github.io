import { action } from '@ember/object'
import { guidFor } from '@ember/object/internals'
import { isEmpty } from '@ember/utils'
import Component from '@glimmer/component'
import { tracked } from '@glimmer/tracking'
import { on } from '@ember/modifier'
import OdyIcon from './icon.gjs'
import OdyButton from './button.gjs'
import OdyMessage from './message.gjs'

function concat (...values) {
	  return values.join('')
}

export default class OdyInput extends Component {
  @tracked writtenCharacters = this.currentValue?.length ?? 0

  uniqueId = `ody-input-${guidFor(this)}`

  get currentValue () {
    return this.args.value || ''
  }

  get clearEnabled () {
    if (this.args.disableClearButton || this.args.disabled || this.args.readonly) {
      return false
    }

    return !isEmpty(this.args.value)
  }

  get showCharacterCounter () {
    const hideCharRemaining = this.args.hideCharRemaining || this.args.readonly || this.args.disabled
    return !hideCharRemaining && !isEmpty(this.args.maxlength)
  }

  get showWarning () {
    return !isEmpty(this.args.warning) && !this.args.hideWarning
  }

  get showInfo () {
    return !isEmpty(this.args.info) && !this.args.hideInfo
  }

  get showCaption () {
    return !isEmpty(this.args.caption)
  }

  get showFooter () {
    return (
      this.showCharacterCounter ||
      this.showWarning ||
      this.showInfo ||
      this.showCaption
    )
  }

  @action
  handleInput (e) {
    const value = e.target?.value ?? ''
    this.writtenCharacters = value.length
    this.args.onChange?.(value)
  }

  @action
  onClear (e) {
    if (this.args.stopClearEventPropagation) {
      e?.stopPropagation()
    }

    this.writtenCharacters = 0

    if (this.args.onClear) {
      this.args.onClear()
    } else {
      this.args.onChange?.('')
    }
  }

  <template>
    {{! template-lint-disable no-down-event-binding }}
    <div
      data-test-ody-input-container
      aria-disabled={{@disabled}}
      class="ody-input
        {{if @info 'ody-input--info'}}
        {{if @warning 'ody-input--warning'}}
        {{if @maxContent 'ody-input--max-content'}}
        {{if @fullWidth 'ody-input--full-width'}}
        "
    >
      {{#if @label}}
        <label data-test-ody-input-label class="ody-input__label" for={{this.uniqueId}}>
          {{@label}}

          {{yield to="postLabel"}}
        </label>
      {{/if}}

      <div
        data-test-input-container
        aria-disabled={{@disabled}}
        class="ody-input__container
          {{if @iti 'ody-input__container--iti'}}
          {{if @textarea 'ody-input__container--textarea'}}
          {{if @readonly 'ody-input__container--readonly'}}
          {{if @size (concat 'ody-input__container--' @size)}}
          "
      >
        {{yield to="leading"}}

	        {{#if @icon}}
	          <div class="ody-input__icon">
	            <OdyIcon @source={{@icon}} @size="small" data-test-ody-input-info-icon />
	          </div>
	        {{/if}}

        {{#if @textarea}}
          <textarea
            id={{this.uniqueId}}
            class="ody-input__textarea"
            value={{this.currentValue}}
            maxlength={{@maxlength}}
            readonly={{@readonly}}
            disabled={{@disabled}}
            rows="3"
            {{on "input" this.handleInput}}
            data-test-ody-input-textarea
            ...attributes
          >
          </textarea>
        {{else}}
          <input
            id={{this.uniqueId}}
            class="ody-input__field {{if @iti 'ody-input__field--iti'}} "
            value={{this.currentValue}}
            maxlength={{@maxlength}}
            readonly={{@readonly}}
            disabled={{@disabled}}
            placeholder={{@placeholder}}
            {{on "input" this.handleInput}}
            data-test-ody-input
            ...attributes
          />
        {{/if}}

	        {{#if this.clearEnabled}}
	          <OdyButton
	            @variant="ghost"
	            @onClick={{this.onClear}}
	            class="ody-input__clear-button"
	            aria-label="Clear"
	            data-test-ody-input-clear-button
	          >
	            <OdyIcon class="clear-icon" @source="close" @size="base" data-test-ody-input-clear-icon />
	          </OdyButton>
	        {{/if}}

	        {{yield to="trailing"}}
      </div>

      {{#if this.showFooter}}
        <div class="ody-input__footer">
          <div class="ody-input__message__container">
	            {{#if this.showCaption}}
	              <OdyMessage class="ody-input__caption" data-test-ody-input-caption>
	                {{@caption}}
	              </OdyMessage>
	            {{/if}}

	            {{#if this.showWarning}}
	              <OdyMessage @message="warning" data-test-ody-input-warning>
	                {{@warning}}
	              </OdyMessage>
	            {{/if}}

	            {{#if this.showInfo}}
	              <OdyMessage class="ody-input__info" @message="info" data-test-ody-input-info>
	                {{@info}}
	              </OdyMessage>
	            {{/if}}
          </div>

          {{#if this.showCharacterCounter}}
            <div data-test-ody-input-max-length class="ody-input__length-message">
              {{this.writtenCharacters}}
              /
              {{@maxlength}}
            </div>
          {{/if}}
        </div>
      {{/if}}
    </div>

  </template>
}
