import Component from '@glimmer/component';
import { action } from '@ember/object';
import { on } from '@ember/modifier';
// import EnterpriseIcon from './icon.gjs';
// import EnterpriseLoadingSpinner from './loading-spinner.gjs';

// Helper local para substituir o helper `or` do pacote externo.
// Retorna o primeiro valor "truthy" ou, se todos forem falsy,
// retorna o último valor da lista (semelhante ao helper Ember `or`).
function or(...values) {
	for (let value of values) {
		if (value) {
			return value;
		}
	}

	return values[values.length - 1];
}

export default class EnterpriseButton extends Component {
  get variantClass() {
    return this.args.variant === 'ghost' ? 'light' : this.args.variant;
  }

  @action
  handleClick(event) {
    this.args.onClick?.(event);

    let target = event.target;
    let parent = target && target.parentNode && target.parentNode.parentNode;

    if (this.args.variant === 'ghost' && parent && typeof parent.blur === 'function') {
      parent.blur();
    }
  }

  <template>
    <button
      type={{or @type "button"}}
      class="
        enterprise-button
        btn
        btn-{{or this.variantClass "primary"}}
        enterprise-button--size-{{or @size "base"}}
        {{or @appearance "interaction"}}
        {{if @isLoading "enterprise-button--loading"}}
        {{if @isIconOnly "enterprise-button--icon-only"}}
        {{if @isActive "enterprise-button--active"}}
        {{if @isDisabled "enterprise-button--disabled"}}
        {{if @iconRotate "enterprise-button--rotate"}}
      "
      disabled={{@isDisabled}}
      aria-expanded={{if @isActive "true" "false"}}
      {{on "click" this.handleClick}}
      data-test-enterprise-button
      ...attributes
    >
      {{#if @leftIcon}}
        {{!-- <EnterpriseIcon
          class="enterprise-button__left-icon"
          @size={{@iconSize}}
          @source={{@leftIcon}}
          data-test-enterprise-button-left-icon
        /> --}}
      {{/if}}

      {{yield}}
      {{@label}}

      {{#if @rightIcon}}
        {{!-- <EnterpriseIcon
          class="enterprise-button__right-icon"
          @size={{@iconSize}}
          @source={{@rightIcon}}
          data-test-enterprise-button-right-icon
        /> --}}
      {{/if}}

      {{#if @isLoading}}
        <div class="enterprise-button__loading-wrapper">
          {{!-- <EnterpriseLoadingSpinner
            @source="spinner"
            data-test-enterprise-button-loading
          /> --}}
        </div>
      {{/if}}
    </button>
  </template>
}

