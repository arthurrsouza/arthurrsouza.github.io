import Component from '@glimmer/component';
import EnterpriseIcon from './icon';

export default class MessageComponent extends Component {
  get getIcon() {
    return this.args.message ? `icon-${this.args.message}` : 'info';
  }

  <template>
    <div class="enterprise-message-container" aria-label={{@accessibilityLabel}} data-test-enterprise-message-container ...attributes>
      <EnterpriseIcon class="enterprise-message__icon" @source={{this.getIcon}} @size="small" />
      <span class="enterprise-message" data-test-enterprise-message>{{yield}}</span>
    </div>
  </template>
}

