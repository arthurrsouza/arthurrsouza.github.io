import { guidFor } from '@ember/object/internals';
import Component from '@glimmer/component';
import PowerSelect from 'ember-power-select/components/power-select';

import EnterpriseDropdownOptions from './options.gjs';
import EnterpriseDropdownTrigger from './trigger.gjs';
import EnterpriseDropdownSingleSearch from './search.gjs';

function concat(a, b) {
	return `${a}-${b}`;
}

export default class EnterpriseDropdownSingle extends Component {
	allowClear = this.args.allowClear ?? true;
	uniqueId = `enterprise-input-${guidFor(this)}`;

	get disabled() {
		return this.args.disabled ?? this.args.readonly ?? false;
	}

	get disabledCompare() {
		return this.args.disabledCompare ?? (() => {});
	}

	get extra() {
		return {
			disabledCompare: this.disabledCompare,
		};
	}

	<template>
    <div
      class="enterprise-dropdown {{if @icon 'enterprise-dropdown--has-icon'}} {{if @disabled 'enterprise-dropdown--disabled'}}"
      data-test-enterprise-dropdown
      ...attributes
    >
			{{#if @label}}
				<label class="enterprise-input__label" id={{this.uniqueId}}>
					{{@label}}

					{{#if @labelTooltip}}
					{{/if}}
				</label>
			{{/if}}

			{{#if @icon}}
			{{/if}}

      <PowerSelect
        class="enterprise-dropdown-single enterprise-dropdown-single--size-{{if @size @size 'base'}}
          {{if @message (concat 'enterprise-dropdown--has-' @messageType '-message')}}
          {{if @readonly 'enterprise-dropdown-single--readonly'}}"
				@renderInPlace={{@renderInPlace}}
				@placeholder={{@placeholder}}
				@selected={{@selected}}
				@searchEnabled={{@searchEnabled}}
				@searchField={{@searchField}}
				@searchPlaceholder={{@searchPlaceholder}}
				@options={{@options}}
				@onChange={{@onChange}}
				disabled={{this.disabled}}
				@extra={{this.extra}}
				@allowClear={{this.allowClear}}
				@optionsComponent={{EnterpriseDropdownOptions}}
				@triggerComponent={{EnterpriseDropdownTrigger}}
        @beforeOptionsComponent={{EnterpriseDropdownSingleSearch}}
				@initiallyOpened={{@initiallyOpened}}
				@ariaLabelledBy={{this.uniqueId}}
				data-test-enterprise-dropdown-single
				as |option|
			>
				{{yield option}}
			</PowerSelect>

			{{#if @message}}
				<div class="enterprise-dropdown__message">
				</div>
			{{/if}}
		</div>
	</template>
}
