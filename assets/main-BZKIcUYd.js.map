import PowerSelectTriggerComponent from 'ember-power-select/components/power-select/trigger';
import EnterpriseButton from '../button.gjs';
import EnterpriseIcon from '../icon.gjs';

function and(a, b) {
	return a && b;
}

function not(a) {
	return !a;
}

export default class EnterpriseDropdownSingleTrigger extends PowerSelectTriggerComponent {
	<template>
		{{#if @select.selected}}
			<span class="ember-power-select-selected-item" data-test-enterprise-dropdown-single-selection>
				{{yield @select.selected @select}}
			</span>
			{{#if (and @allowClear (not @select.disabled))}}
				<EnterpriseButton
					@variant="ghost"
					@onClick={{this.clear}}
					data-test-enterprise-dropdown-single-clear
					class="ember-power-select-clear-btn single-select-clear"
					aria-label="Clear"
				>
					<EnterpriseIcon @source="close" @size="base" />
				</EnterpriseButton>
			{{/if}}
		{{else}}
			<this.args.placeholderComponent @placeholder={{@placeholder}} />
		{{/if}}

		<span class="ember-power-select-status-icon">
			<EnterpriseIcon @source="carat-down" @size="small" />
		</span>
	</template>
}
