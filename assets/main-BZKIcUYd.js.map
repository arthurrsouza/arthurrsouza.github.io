import PowerSelectBeforeOptionsComponent from 'ember-power-select/components/power-select/before-options'
import EnterpriseInput from '../input.gjs';
import { on } from '@ember/modifier';

export default class EnterpriseDropdownMultiBeforeOptions extends PowerSelectBeforeOptionsComponent {
  <template>

    {{#if @searchEnabled}}
      <div class="ember-power-select-search" data-test-enterprise-dropdown-single-search>
        <EnterpriseInput
          type="search"
          autocomplete="off"
          autocorrect="off"
          autocapitalize="off"
          spellcheck={{false}}
          role="combobox"
          @disableClearButton={{true}}
          value={{@select.searchText}}
          aria-activedescendant={{@ariaActiveDescendant}}
          aria-controls={{@listboxId}}
          aria-haspopup="listbox"
          placeholder={{@searchPlaceholder}}
          @icon="search"
          {{on "input" @onInput}}
          {{on "focus" @onFocus}}
          {{on "blur" @onBlur}}
          data-test-ember-power-select-search-input
        />
      </div>
    {{/if}}

  </template>
}
