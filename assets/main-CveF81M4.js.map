import Component from '@glimmer/component';

function or(...values) {
	for (let value of values) {
		if (value) {
			return value;
		}
	}

	return values[values.length - 1];
}

function eq(a, b) {
	return a === b;
}

export default class IconComponent extends Component {
  <template>
    {{#let
      (or @size "small")
      as |size|
    }}
      <span
        class="
          icon
          icon--size-{{size}}
          {{if @isDisabled "icon--disabled"}}
        "
        aria-label={{@accessibilityLabel}}
        data-test-ody-icon
        ...attributes
      >
        {{#if (eq @source "placeholder")}}
          <div data-test-ody-icon-placeholder class="icon__placeholder"></div>
        {{else if @source}}

        {{/if}}

        {{yield}}
      </span>
    {{/let}}

  </template>
}

