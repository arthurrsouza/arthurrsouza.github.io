import Component from '@glimmer/component';

function or(...values) {
	for (let value of values) {
		if (value) {
			return value;
		}
	}

	return values[values.length - 1];
}

export default class LoadingSpinnerComponent extends Component {
  <template>
    <span class="loading-spinner-container" ...attributes>
      <div
        class="
          loading-spinner
          loading-spinner--size-{{or @size "small"}}
        "
        data-test-ody-loading-spinner
      >
        {{#if @source}}

        {{/if}}
      </div>

      <label class="loading-spinner__label-field" data-test-ody-loading-spinner-label>
        {{@label}}
      </label>
    </span>
  </template>
}

